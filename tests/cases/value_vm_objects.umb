CLASS BOX:
    INT_VALUE = 0
    FUNC INIT(INT_START):
        SELF.INT_VALUE = INT_START
    END
    FUNC ADD(INT_AMOUNT):
        SELF.INT_VALUE = SELF.INT_VALUE + INT_AMOUNT
        RETURN SELF.INT_VALUE
    END
END

FUNC USE_BOX(INT_START):
    OBJ_BOX = BOX(INT_START)
    INT_FIRST = OBJ_BOX.ADD(5)
    OBJ_BOX.INT_VALUE = OBJ_BOX.INT_VALUE + 2
    TRY:
        INT_BAD = 1 / 0
    CATCH: STR_ERROR
        RETURN OBJ_BOX.INT_VALUE + LEN(STR_ERROR) * 0
    END
    RETURN INT_FIRST
END

PRINT: USE_BOX(10)
