FUNC GREET(STR_NAME, INT_COUNT):
    STR_TEXT = "Hello, [STR_NAME]! x[INT_COUNT]"
    IF: INT_COUNT > 1
        RETURN STR_TEXT + "!"
    END
    RETURN STR_TEXT
END

FUNC ARRAY_INFO(INT_X):
    ARR_VALUES = [INT_X, INT_X + 1, INT_X + 2]
    RETURN JOIN(ARR_VALUES, ":")
END

PRINT: GREET("Umbrly", 2)
PRINT: ARRAY_INFO(7)
