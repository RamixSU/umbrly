FUNC FOR_TEST(INT_N):
    INT_SUM = 0
    FOR: INT_I = 1 TO INT_N
        IF: INT_I == 3
            CONTINUE
        END
        IF: INT_I > 7
            BREAK
        END
        INT_SUM = INT_SUM + INT_I
    END
    FOR: INT_J = 3 TO 1 STEP -1
        INT_SUM = INT_SUM + INT_J
    END
    RETURN INT_SUM
END
PRINT: FOR_TEST(20)
