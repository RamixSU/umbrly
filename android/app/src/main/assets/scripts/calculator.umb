FUNC SAFE_DIV(FLOAT_A, FLOAT_B):
    IF: FLOAT_B == 0
        RETURN 0
    END
    RETURN FLOAT_A / FLOAT_B
END

FLOAT_A = 42
FLOAT_B = 6

PRINT: "Calculator"
PRINT: "[FLOAT_A] + [FLOAT_B] = [FLOAT_A + FLOAT_B]"
PRINT: "[FLOAT_A] - [FLOAT_B] = [FLOAT_A - FLOAT_B]"
PRINT: "[FLOAT_A] * [FLOAT_B] = [FLOAT_A * FLOAT_B]"
PRINT: "[FLOAT_A] / [FLOAT_B] = [FLOAT_A / FLOAT_B]"
PRINT: "SAFE_DIV(10, 0) = [SAFE_DIV(10, 0)]"
